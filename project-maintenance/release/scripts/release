#!/bin/bash
#
# Usage: scripts/release [major|minor|patch]
#
# Checks git, runs tests, bumps the version, builds, tags and pushes. Stops short of publishing.

set -euo pipefail

pkg_dir="."

# Node (npm):
test_cmd="npm run test"
build_cmd="npm run build"
bump_version_cmd="npm version VERSION --no-git-tag-version"
version_cmd="node -p 'require(\"./package.json\").version'"
publish_cmd="npm run publish"

# Python (uv):
#   test_cmd="uv run pytest"
#   build_cmd="rm -rf dist && uv build"
#   bump_version_cmd="uv version --bump VERSION"
#   version_cmd="uv version --short"
#   publish_cmd="uv publish"

cd "$(git rev-parse --show-toplevel)"

green_echo() {
    echo -e "\033[0;32m$1\033[0m"
}

red_echo() {
    echo -e "\033[0;31m$1\033[0m"
}

check_uncommitted_changes() {
    if [[ $(git status --porcelain) ]]; then
        red_echo "Error: There are uncommitted changes in your working directory."
        red_echo "Please commit or stash these changes before releasing."
        git status
        exit 1
    else
        green_echo "Working directory is clean."
    fi
}

check_git_sync() {
    git remote update
    LOCAL=$(git rev-parse @)
    REMOTE=$(git rev-parse '@{u}')
    BASE=$(git merge-base @ '@{u}')

    if [ "$LOCAL" = "$REMOTE" ]; then
        green_echo "Git is up to date with remote."
    elif [ "$LOCAL" = "$BASE" ]; then
        red_echo "Error: Your local branch is behind the remote branch. Please pull the latest changes."
        exit 1
    elif [ "$REMOTE" = "$BASE" ]; then
        red_echo "Error: Your local branch is ahead of the remote branch. Please push your changes."
        exit 1
    else
        red_echo "Error: Your local and remote branches have diverged. Please resolve conflicts before releasing."
        exit 1
    fi
}

version_type="${1:-}"
if [ -z "$version_type" ]; then
    read -r -p "Enter version increment type (major/minor/patch): " version_type
fi
case "$version_type" in
    major | minor | patch) ;;
    *)
        red_echo "Error: version increment must be major, minor or patch (got '$version_type')."
        exit 1
        ;;
esac

green_echo "Starting release process..."

green_echo "Step 1: Checking for uncommitted changes..."
check_uncommitted_changes

green_echo "Step 2: Checking if git is synced with remote..."
check_git_sync

green_echo "Step 3: Running tests..."
bash -eo pipefail -c "$test_cmd"
green_echo "All tests passed successfully."

green_echo "Step 4: Incrementing version..."
(cd "$pkg_dir" && bash -eo pipefail -c "${bump_version_cmd//VERSION/$version_type}" >/dev/null)
tag="v$(cd "$pkg_dir" && bash -eo pipefail -c "$version_cmd")"
green_echo "Version updated to $tag."

green_echo "Step 5: Running build..."
if ! bash -eo pipefail -c "$build_cmd"; then
    red_echo "Error: Build failed. Nothing was committed. Undo the version bump with: git checkout -- ."
    exit 1
fi
green_echo "Build completed successfully."

green_echo "Step 6: Creating commit and git tag..."
git commit -am "${tag#v}"
git tag -a "$tag" -m "${tag#v}"
green_echo "Commit and tag $tag created."

green_echo "Step 7: Pushing to remote..."
git push --follow-tags
green_echo "Pushed successfully."

green_echo "Release preparation completed successfully!"
green_echo "To publish, run '$publish_cmd'"
