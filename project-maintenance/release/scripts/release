#!/usr/bin/env bash
#
# The whole release flow. bash + git + gh + awk, nothing else.
#
#   just release 1.2.3          test, bump, changelog, commit, tag, publish,
#                               push, create the GitHub release
#   just release-finish 1.2.3   push and create the release for an already
#                               published version. Safe to rerun.
#   just unrelease 1.2.3        undo a release that never left this machine
#
# Version format: MAJOR.MINOR.PATCH, no "v" (the tag adds it).
#   breaking change → major · new feature → minor · fix → patch
#   Before 1.0: breaking change → minor.  First release: 0.1.0
#
# Before releasing, add notes under "## Unreleased" in CHANGELOG.md. They
# become the GitHub release notes.
#
# If something fails:
#   before publish → just unrelease 1.2.3       (nothing left your machine)
#   after publish  → just release-finish 1.2.3  (never roll back a published
#                                                version; only go forward)
#
# ---------------------------------------------------------------------------
# EDIT THESE THREE. VERSION in bump_cmd becomes the version being released.
# ---------------------------------------------------------------------------

test_cmd="npm test"
bump_cmd="npm version VERSION --no-git-tag-version"
publish_cmd="npm publish"

# Presets — copy one set over the three above.
#
#   node:           test_cmd="npm test"
#                   bump_cmd="npm version VERSION --no-git-tag-version"
#                   publish_cmd="npm publish"
#
#   python (uv):    test_cmd="uv run pytest"
#                   bump_cmd="uv version VERSION"
#                   publish_cmd="rm -rf dist && uv build && uv publish"
#
#   ships nothing:  publish_cmd="true"
#
# ---------------------------------------------------------------------------
#
# Decisions behind this flow:
#   - Releases run from main only. No dev/main promotion.
#   - No prereleases.
#   - Protected org repos: don't use this starter; release through CI.
#   - Credentials: each ecosystem's native login (npm login; uv/PyPI token in
#     keyring or env). Never commit tokens.
#   - Tags are "v"-prefixed. To namespace them (e.g. lib-v*), change tag_of.
#   - Nothing is committed until every check has passed. The checks and
#     `git commit -am` depend on each other: don't remove the clean-tree check.
#   - Changelog file: set $CHANGELOG to use something other than CHANGELOG.md.

set -euo pipefail

changelog="${CHANGELOG:-CHANGELOG.md}"

# Errors follow one rule, so there is never a question of who handles what:
#
#   cl_* helpers        print to stderr and `return 1`. The caller decides.
#   everything else     calls fail/fail_dirty, which exit. Nothing catches
#                       them, so no caller has to think about it.
#
# Anything a caller would want to add context to therefore lives in a cl_*
# helper. Anything terminal says, in its own message, how to recover.

fail() { echo "error: $*" >&2; exit 1; }
warn() { echo "warning: $*" >&2; }

# Like fail, but for failures after the bump has already touched files. The
# checks proved the tree was clean beforehand, so discarding everything is safe.
fail_dirty() {
  local undo="git checkout -- ."
  if [ -n "$(git ls-files --others --exclude-standard)" ]; then
    undo="$undo && git clean -fd"
  fi
  if [ -n "$(git status --porcelain)" ]; then
    fail "$* Nothing is committed. Undo with: $undo"
  fi
  fail "$* Nothing changed."
}

tag_of() { echo "v$1"; }

usage() {
  echo "usage: scripts/release release | finish | unrelease VERSION" >&2
  exit 2
}

# --- CHANGELOG.md ------------------------------------------------------------

# Shared by every changelog function: is this line the "## NAME" heading?
# Matches "## 1.2.3" and "## 1.2.3 - 2026-01-01", but not "## 1.2.30" or
# "### 1.2.3".
cl_awk_lib='
function heading_name(line) {
  if (line !~ /^## /) return ""
  sub(/^## +/, "", line)
  sub(/[ \t]+$/, "", line)
  return line
}
function is_heading(line, name,   h) {
  h = heading_name(line)
  return h == name || index(h, name " ") == 1
}'

# Print the body of section NAME (the lines between its heading and the next
# "## " heading). Exits 3 if the section doesn't exist.
cl_section_body() {
  awk -v name="$1" "$cl_awk_lib"'
    /^## / { if (inside) exit; if (is_heading($0, name)) { inside = 1; found = 1; next } }
    inside { print }
    END { if (!found) exit 3 }
  ' "$changelog"
}

# True if section NAME exists and has at least one non-blank line.
cl_has_notes() {
  local body
  body=$(cl_section_body "$1") || return 1
  case "$body" in
    *[![:space:]]*) return 0 ;;
    *) return 1 ;;
  esac
}

# Returns 1 unless "## Unreleased" has notes under it.
cl_check() {
  if [ ! -f "$changelog" ] || ! cl_has_notes Unreleased; then
    echo "$changelog has no notes under \"## Unreleased\" — add a line describing this release, then rerun." >&2
    return 1
  fi
}

# Turn "## Unreleased" into "## VERSION - DATE", leaving an empty
# "## Unreleased" on top for next time.
cl_rotate() {
  local version="$1" today tmp
  cl_check || return 1
  if cl_section_body "$version" > /dev/null 2>&1; then
    echo "$changelog already has a \"## $version\" section — pick a new version." >&2
    return 1
  fi
  today=$(date +%Y-%m-%d)
  tmp="$changelog.tmp.$$"
  awk -v version="$version" -v today="$today" "$cl_awk_lib"'
    !done && is_heading($0, "Unreleased") {
      print "## Unreleased"; print ""; print "## " version " - " today; done = 1; next
    }
    { print }
  ' "$changelog" > "$tmp"
  mv "$tmp" "$changelog"
}

# Print the notes for VERSION, trimmed of leading and trailing blank lines.
cl_notes() {
  local version="$1" body
  if [ ! -f "$changelog" ]; then
    echo "$changelog not found." >&2
    return 1
  fi
  if ! body=$(cl_section_body "$version"); then
    echo "$changelog has no \"## $version\" section." >&2
    return 1
  fi
  printf '%s\n' "$body" | awk '
    NF { if (!started) started = 1; for (i = 0; i < blank; i++) print ""; blank = 0; print; next }
    started { blank++ }
  '
}

# --- Checks ------------------------------------------------------------------

# True if $1 > $2, both MAJOR.MINOR.PATCH. Numeric, so 0.10.0 > 0.9.0.
version_gt() {
  local a1 a2 a3 b1 b2 b3
  IFS=. read -r a1 a2 a3 <<< "$1"
  IFS=. read -r b1 b2 b3 <<< "$2"
  a1=$((10#$a1)); a2=$((10#$a2)); a3=$((10#$a3))
  b1=$((10#$b1)); b2=$((10#$b2)); b3=$((10#$b3))
  [ "$a1" -ne "$b1" ] && { [ "$a1" -gt "$b1" ]; return; }
  [ "$a2" -ne "$b2" ] && { [ "$a2" -gt "$b2" ]; return; }
  [ "$a3" -gt "$b3" ]
}

# Everything that must be true before VERSION can be released. Changes nothing,
# so a failure here always leaves the project exactly as it was.
check_releasable() {
  local version="$1" tag last semver branch remote_tag pr_rules protected
  tag=$(tag_of "$version")

  # 1. Version format
  semver='^[0-9]+\.[0-9]+\.[0-9]+$'
  [[ "$version" =~ $semver ]] || fail 'Version must look like 1.2.3 (no "v" prefix).'

  # 2. Tools
  command -v git > /dev/null || fail "git not found — install it: https://git-scm.com"
  command -v gh > /dev/null || fail "gh not found — install it: https://cli.github.com"

  # 3. Branch
  branch=$(git branch --show-current)
  [ "$branch" = main ] || fail "Releases run from main (you're on ${branch:-a detached HEAD}) — git switch main"

  # 4. Clean tree, untracked files included (release relies on this for `git commit -am`)
  [ -z "$(git status --porcelain)" ] || fail "Working tree not clean — commit or stash first. git status"

  # 5. Changelog notes
  cl_check || exit 1

  # 6. Version goes up. No tags yet means this is the first release.
  last=$(git tag --list 'v*' --sort=-v:refname | awk '/^v[0-9]+\.[0-9]+\.[0-9]+$/ && !found { print substr($0, 2); found = 1 }')
  if [ -n "$last" ]; then
    if [ "$version" = "$last" ]; then
      fail "Tag $tag already exists locally — pick a new version, or git tag -d $tag if it's stale."
    fi
    version_gt "$version" "$last" || fail "$version must be greater than the last release ($last)."
  fi

  # 7. Tag is new locally
  if git rev-parse -q --verify "refs/tags/$tag" > /dev/null; then
    fail "Tag $tag already exists locally — pick a new version, or git tag -d $tag if it's stale."
  fi

  # 8. In sync with origin (--no-tags: this check doesn't create local tags)
  git fetch --quiet --no-tags origin main || fail "Couldn't fetch from origin — check your network and remote, then rerun."
  [ "$(git rev-parse HEAD)" = "$(git rev-parse origin/main)" ] || fail "Not in sync with origin/main — git pull (or push your commits first)."

  # 9. Tag is new on origin
  remote_tag=$(git ls-remote --tags origin "refs/tags/$tag") || fail "Couldn't list tags on origin — check your network and remote, then rerun."
  [ -z "$remote_tag" ] || fail "Tag $tag already exists on origin — pick a new version."

  # 10. gh can create the GitHub release
  gh auth status > /dev/null 2>&1 || fail "gh is not authenticated — gh auth login"

  # 11. Branch protection. Best effort: an unreachable API never blocks a release.
  if pr_rules=$(gh api 'repos/{owner}/{repo}/rules/branches/main' --jq '[.[] | select(.type=="pull_request")] | length' 2> /dev/null); then
    if [[ "$pr_rules" =~ ^[1-9] ]]; then
      fail "main requires pull requests — this starter can't push there. Protected repos should release through CI."
    fi
  else
    warn "Couldn't check main's rulesets on GitHub — continuing."
  fi
  if protected=$(gh api 'repos/{owner}/{repo}/branches/main' --jq .protected 2> /dev/null); then
    if [ "$protected" = true ]; then
      warn "main has classic branch protection — if it requires reviews, the push will be rejected after publishing. Ctrl-C now if so."
    fi
  else
    warn "Couldn't check main's branch protection on GitHub — continuing."
  fi

  echo "Ready to release $version${last:+ (last release: $last)}"
}

# --- Commands ----------------------------------------------------------------

# Test, bump, tag, publish, push, and create the GitHub release.
cmd_release() {
  local version="$1" tag bump
  tag=$(tag_of "$version")

  check_releasable "$version"

  echo "==> Testing"
  bash -eo pipefail -c "$test_cmd" \
    || fail_dirty "Tests failed. Fix them, then rerun: just release $version"

  echo "==> Bumping to $version"
  bump=${bump_cmd//VERSION/$version}
  bash -eo pipefail -c "$bump" || fail_dirty "Bump failed."

  echo "==> Updating $changelog"
  cl_rotate "$version" || fail_dirty "Changelog update failed."

  echo "==> Committing and tagging $tag"
  git commit --quiet -am "Release $version" || fail_dirty "Commit failed."
  git tag -a "$tag" -m "$tag" || fail "Tagging failed. Undo the release commit with: git reset --keep HEAD~1"

  # Point of no return: once publish succeeds, never roll back. Finish forward.
  echo "==> Publishing"
  if ! bash -eo pipefail -c "$publish_cmd"; then
    fail "Publish failed — nothing has left your machine. Undo with: just unrelease $version"
  fi

  # Say so out loud, because every failure from here on is a finish-forward
  # one and cmd_finish's own messages all name release-finish. That's why
  # this can just call cmd_finish and let it exit on its own.
  echo "==> Published $version. There is no going back now, only forward."
  cmd_finish "$version"
}

# Push and create the GitHub release for a published VERSION. Safe to rerun.
cmd_finish() {
  local version="$1" tag branch notes url
  tag=$(tag_of "$version")

  git rev-parse -q --verify "refs/tags/$tag" > /dev/null || fail "No local tag $tag — nothing to finish."
  branch=$(git branch --show-current)
  [ "$branch" = main ] || fail "release-finish pushes main (you're on ${branch:-a detached HEAD}) — git switch main, then rerun: just release-finish $version"
  git merge-base --is-ancestor "$tag^{commit}" HEAD \
    || fail "HEAD doesn't contain $tag, so pushing main wouldn't publish it. Get main back to (or after) $tag, then rerun: just release-finish $version"

  echo "==> Pushing main and $tag"
  git push origin main --follow-tags \
    || fail "Push failed. Fix the problem above, then rerun: just release-finish $version"

  if gh release view "$tag" > /dev/null 2>&1; then
    echo "GitHub release $tag already exists"
  else
    echo "==> Creating GitHub release $tag"
    notes=$(cl_notes "$version") || fail "Couldn't read notes for $version from $changelog."
    # Notes go in over stdin, so nothing depends on a tempfile surviving.
    printf '%s\n' "$notes" \
      | gh release create "$tag" --verify-tag --title "$tag" --notes-file - > /dev/null \
      || fail "Couldn't create the GitHub release. Fix the problem above, then rerun: just release-finish $version"
  fi

  url=$(gh release view "$tag" --json url --jq .url 2> /dev/null || true)
  echo "Released $version${url:+ — $url}"
}

# Undo a release that never left this machine: drop the tag and release commit.
cmd_unrelease() {
  local version="$1" tag remote_tag
  tag=$(tag_of "$version")

  git rev-parse -q --verify "refs/tags/$tag" > /dev/null \
    || fail "No local tag $tag — nothing to unrelease. If files were left modified, undo with: git checkout -- ."

  remote_tag=$(git ls-remote --tags origin "refs/tags/$tag") || fail "Couldn't check origin for $tag — check your network and remote, then rerun."
  [ -z "$remote_tag" ] || fail "$tag is already on origin — it's public. Release forward with a new version instead."

  [ "$(git rev-parse HEAD)" = "$(git rev-parse "$tag^{commit}")" ] \
    || fail "HEAD isn't the $tag release commit. Undo by hand: git tag -d $tag, then remove the \"Release $version\" commit."
  [ "$(git log -1 --format=%s)" = "Release $version" ] \
    || fail "HEAD isn't a \"Release $version\" commit. Undo by hand: git tag -d $tag"

  # --keep refuses rather than discard uncommitted changes.
  git reset --quiet --keep HEAD~1 \
    || fail "Couldn't remove the release commit without losing local changes — stash them, then rerun: just unrelease $version"
  git tag -d "$tag" > /dev/null
  echo "Unreleased $version: deleted $tag and the release commit."
}

main() {
  cd "$(dirname "${BASH_SOURCE[0]}")/.."
  [ $# -eq 2 ] || usage
  case "$1" in
    release)   cmd_release "$2" ;;
    finish)    cmd_finish "$2" ;;
    unrelease) cmd_unrelease "$2" ;;
    *) usage ;;
  esac
}

# Run only when executed. Sourcing this file just defines the functions, which
# is how tests/release/run exercises the changelog handling.
if [ "${BASH_SOURCE[0]}" = "$0" ]; then
  main "$@"
fi
