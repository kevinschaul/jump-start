#!/usr/bin/env bash
# Tests for the release starter: scripts/changelog, then the whole release flow.
#
#   tests/run
#
# Plain bash. Each case builds a throwaway bare "origin" and working clone
# under mktemp -d, with the three commands set to harmless ones and a stub gh
# on PATH, so nothing touches a real registry or GitHub. Needs git and just.
set -euo pipefail

STARTER=$(cd "$(dirname "$0")/.." && pwd)
ROOT=$(mktemp -d "${TMPDIR:-/tmp}/release-tests.XXXXXX")
trap 'rm -rf "$ROOT"' EXIT

command -v just > /dev/null || { echo "just not found — install it: https://just.systems" >&2; exit 1; }

# Keep the user's git config (signing, hooks, default branch) out of the sandbox.
export HOME="$ROOT/home"
export GIT_CONFIG_NOSYSTEM=1
mkdir -p "$HOME"
git config --global user.name "Release Tests"
git config --global user.email "release-tests@example.com"
git config --global init.defaultBranch main
git config --global commit.gpgSign false
git config --global tag.gpgSign false
git config --global advice.detachedHead false

# --- Harness -----------------------------------------------------------------

passed=0
failed=0

section() { echo "- $1"; }

# run CMD...: capture combined output in $out and exit status in $status.
run() {
  set +e
  out=$("$@" 2>&1)
  status=$?
  set -e
}

# check DESCRIPTION CMD...: record whether CMD succeeds.
check() {
  local desc="$1"
  shift
  if "$@"; then
    passed=$((passed + 1))
  else
    failed=$((failed + 1))
    echo "    FAIL: $desc"
    printf '%s\n' "${out:-}" | sed 's/^/      | /'
  fi
}

not() { ! "$@"; }
status_is() { [ "$status" -eq "$1" ]; }
output_has() { case "$out" in *"$1"*) return 0 ;; *) return 1 ;; esac; }
file_has() { grep -qF -- "$2" "$1"; }
same_file() { cmp -s "$1" "$2"; }
tree_clean() { [ -z "$(git status --porcelain)" ]; }
head_is() { [ "$(git rev-parse HEAD)" = "$1" ]; }
file_is() { [ "$(cat "$1")" = "$2" ]; }
tag_local() { git rev-parse -q --verify "refs/tags/$1" > /dev/null; }
tag_annotated() { [ "$(git cat-file -t "$1")" = tag ]; }
tag_on_origin() { git --git-dir="$O" rev-parse -q --verify "refs/tags/$1" > /dev/null; }
origin_main_is() { [ "$(git --git-dir="$O" rev-parse main)" = "$1" ]; }
gh_release() { [ -f "$GH_STATE/releases/$1" ]; }
gh_calls() { grep -c "^$1" "$GH_STATE/calls" 2> /dev/null || true; }

# A stub gh. Behavior is read from files in $GH_STATE so cases can change it:
#   auth            ok | fail
#   api_rules       count of pull_request rules on main, or "error"
#   api_protected   true | false | error
#   releases/TAG    exists once "release create" ran; holds the notes
mkdir -p "$ROOT/bin"
cat > "$ROOT/bin/gh" << 'STUB'
#!/usr/bin/env bash
set -euo pipefail
echo "$*" >> "$GH_STATE/calls"
case "$1" in
  auth)
    [ "$(cat "$GH_STATE/auth")" = ok ] || { echo "You are not logged into any GitHub hosts." >&2; exit 1; }
    ;;
  api)
    case "$2" in
      */rules/branches/main) value=$(cat "$GH_STATE/api_rules") ;;
      */branches/main) value=$(cat "$GH_STATE/api_protected") ;;
      *) echo "stub gh: unexpected api call: $*" >&2; exit 1 ;;
    esac
    [ "$value" != error ] || { echo "HTTP 502" >&2; exit 1; }
    echo "$value"
    ;;
  release)
    tag="$3"
    case "$2" in
      view)
        [ -f "$GH_STATE/releases/$tag" ] || { echo "release not found" >&2; exit 1; }
        case "$*" in *--json*) echo "https://github.com/example/project/releases/tag/$tag" ;; esac
        ;;
      create)
        notes=""
        shift 3
        while [ $# -gt 0 ]; do
          case "$1" in --notes-file) notes="$2"; shift ;; esac
          shift
        done
        [ -n "$notes" ] || { echo "stub gh: --notes-file required" >&2; exit 1; }
        cp "$notes" "$GH_STATE/releases/$tag"
        ;;
      *) echo "stub gh: unexpected release call: $*" >&2; exit 1 ;;
    esac
    ;;
  *) echo "stub gh: unexpected call: $*" >&2; exit 1 ;;
esac
STUB
chmod +x "$ROOT/bin/gh"
export PATH="$ROOT/bin:$PATH"

# new_project NAME [TEST_CMD] [BUMP_CMD] [PUBLISH_CMD]
# Creates origin + working clone with the starter committed and pushed, cds
# into the clone, and sets $W (clone), $O (bare origin), $GH_STATE.
new_project() {
  local dir="$ROOT/cases/$1"
  local test_cmd="${2:-true}"
  local bump_cmd="${3:-echo VERSION > version.txt}"
  local publish_cmd="${4:-true}"
  mkdir -p "$dir"
  O="$dir/origin.git"
  W="$dir/work"
  git init --quiet --bare "$O"
  git clone --quiet "$O" "$W" 2> /dev/null
  cp -R "$STARTER/scripts" "$STARTER/CHANGELOG.md" "$W/"
  awk -v t="$test_cmd" -v b="$bump_cmd" -v p="$publish_cmd" '
    /^test-cmd := /    { print "test-cmd := \"" t "\""; next }
    /^bump-cmd := /    { print "bump-cmd := \"" b "\""; next }
    /^publish-cmd := / { print "publish-cmd := \"" p "\""; next }
    { print }
  ' "$STARTER/justfile" > "$W/justfile"
  echo 0.0.0 > "$W/version.txt"

  export GH_STATE="$dir/gh"
  mkdir -p "$GH_STATE/releases"
  echo ok > "$GH_STATE/auth"
  echo 0 > "$GH_STATE/api_rules"
  echo false > "$GH_STATE/api_protected"
  : > "$GH_STATE/calls"

  cd "$W"
  git add -A
  git commit --quiet -m "Initial commit"
  git push --quiet origin main 2> /dev/null
}

# add_note TEXT: add a line under "## Unreleased", commit and push it.
add_note() {
  awk -v note="- $1" '
    { print }
    /^## Unreleased/ && !done { print ""; print note; done = 1 }
  ' CHANGELOG.md > CHANGELOG.md.tmp
  mv CHANGELOG.md.tmp CHANGELOG.md
  git commit --quiet -am "Add changelog note"
  git push --quiet origin main 2> /dev/null
}

# release_ok VERSION: add a note and release it, which must succeed.
release_ok() {
  add_note "Changes in $1"
  run just release "$1"
  check "release $1 succeeds" status_is 0
}

# snapshot / unchanged: prove a failed release left everything as it was.
snapshot() {
  snap_head=$(git rev-parse HEAD)
  snap_origin=$(git --git-dir="$O" rev-parse main)
  snap_tags=$(git tag --list)
  cp CHANGELOG.md "$ROOT/changelog.snap"
  cp version.txt "$ROOT/version.snap"
}
unchanged() {
  check "tree clean" tree_clean
  check "HEAD unchanged" head_is "$snap_head"
  check "origin unchanged" origin_main_is "$snap_origin"
  check "tags unchanged" [ "$(git tag --list)" = "$snap_tags" ]
  check "CHANGELOG.md unchanged" same_file CHANGELOG.md "$ROOT/changelog.snap"
  check "version.txt unchanged" same_file version.txt "$ROOT/version.snap"
}

# --- scripts/changelog -------------------------------------------------------

CL="$STARTER/scripts/changelog"
cl_dir="$ROOT/changelog"
mkdir -p "$cl_dir"
export CHANGELOG="$cl_dir/CHANGELOG.md"

section "changelog check: has notes"
printf '# Changelog\n\n## Unreleased\n\n- Added a thing\n\n## 0.1.0 - 2026-01-01\n\n- Old\n' > "$CHANGELOG"
cp "$CHANGELOG" "$cl_dir/before"
run bash "$CL" check
check "exits 0" status_is 0
check "does not write" same_file "$CHANGELOG" "$cl_dir/before"

section "changelog check: notes under a subheading"
printf '# Changelog\n\n## Unreleased\n\n### Fixed\n\n- A bug\n' > "$CHANGELOG"
run bash "$CL" check
check "exits 0" status_is 0

section "changelog check: empty Unreleased"
printf '# Changelog\n\n## Unreleased\n\n## 0.1.0 - 2026-01-01\n\n- Old\n' > "$CHANGELOG"
cp "$CHANGELOG" "$cl_dir/before"
run bash "$CL" check
check "exits 1" status_is 1
check "says what to do" output_has 'has no notes under "## Unreleased" — add a line describing this release, then rerun.'
check "does not write" same_file "$CHANGELOG" "$cl_dir/before"

section "changelog check: empty Unreleased at end of file"
printf '# Changelog\n\n## Unreleased\n' > "$CHANGELOG"
run bash "$CL" check
check "exits 1" status_is 1

section "changelog check: whitespace-only Unreleased"
printf '# Changelog\n\n## Unreleased\n   \n\t\n\n## 0.1.0 - 2026-01-01\n\n- Old\n' > "$CHANGELOG"
run bash "$CL" check
check "exits 1" status_is 1

section "changelog check: missing Unreleased section"
printf '# Changelog\n\n## 0.1.0 - 2026-01-01\n\n- Old\n' > "$CHANGELOG"
run bash "$CL" check
check "exits 1" status_is 1
check "says what to do" output_has 'add a line describing this release'

section "changelog check: missing file"
rm -f "$CHANGELOG"
run bash "$CL" check
check "exits 1" status_is 1
check "says what to do" output_has 'add a line describing this release'
check "does not create the file" [ ! -e "$CHANGELOG" ]

section "changelog rotate"
printf '# Changelog\n\n## Unreleased\n\n- New thing\n\n## 0.1.0 - 2026-01-01\n\n- Old\n' > "$CHANGELOG"
run bash "$CL" rotate 0.2.0
check "exits 0" status_is 0
expected=$(printf '# Changelog\n\n## Unreleased\n\n## 0.2.0 - %s\n\n- New thing\n\n## 0.1.0 - 2026-01-01\n\n- Old' "$(date +%Y-%m-%d)")
check "moves notes under the version, keeps an empty Unreleased" file_is "$CHANGELOG" "$expected"
run bash "$CL" check
check "Unreleased is empty afterwards" status_is 1

section "changelog rotate: refuses empty Unreleased"
cp "$CHANGELOG" "$cl_dir/before"
run bash "$CL" rotate 0.3.0
check "exits 1" status_is 1
check "says what to do" output_has 'add a line describing this release'
check "does not write" same_file "$CHANGELOG" "$cl_dir/before"

section "changelog rotate: refuses an existing version"
printf '# Changelog\n\n## Unreleased\n\n- New\n\n## 0.1.0 - 2026-01-01\n\n- Old\n' > "$CHANGELOG"
cp "$CHANGELOG" "$cl_dir/before"
run bash "$CL" rotate 0.1.0
check "exits 1" status_is 1
check "does not write" same_file "$CHANGELOG" "$cl_dir/before"

section "changelog notes"
printf '# Changelog\n\n## Unreleased\n\n## 0.1.10 - 2026-02-01\n\n- Ten\n\n## 0.1.1 - 2026-01-02\n\n\n- One\n\n- Uno\n\n\n## 0.1.0 - 2026-01-01\n\n- Zero\n' > "$CHANGELOG"
run bash "$CL" notes 0.1.1
check "exits 0" status_is 0
check "prints only that version, trimmed" [ "$out" = "$(printf -- '- One\n\n- Uno')" ]
run bash "$CL" notes 0.1.0
check "last section" [ "$out" = "- Zero" ]
run bash "$CL" notes 0.2.0
check "missing version exits 1" status_is 1

unset CHANGELOG

# --- Release flow ------------------------------------------------------------

section "happy path: first release 0.1.0, then 0.1.1"
new_project happy
add_note "First feature"
run just release 0.1.0
check "exits 0" status_is 0
check "says released" output_has "Released 0.1.0"
check "prints the release URL" output_has "https://github.com/example/project/releases/tag/v0.1.0"
check "tree clean" tree_clean
check "bumped" file_is version.txt 0.1.0
check "commit message" [ "$(git log -1 --format=%s)" = "Release 0.1.0" ]
check "tag is annotated" tag_annotated v0.1.0
check "tag on origin" tag_on_origin v0.1.0
check "main pushed" origin_main_is "$(git rev-parse HEAD)"
check "changelog rotated" file_has CHANGELOG.md "## 0.1.0 - "
check "GitHub release created" gh_release v0.1.0
check "release notes" file_has "$GH_STATE/releases/v0.1.0" "- First feature"
add_note "A fix"
run just release 0.1.1
check "second release exits 0" status_is 0
check "tag v0.1.1 annotated" tag_annotated v0.1.1
check "tag v0.1.1 on origin" tag_on_origin v0.1.1
check "notes for 0.1.1" file_has "$GH_STATE/releases/v0.1.1" "- A fix"
check "notes for 0.1.1 exclude 0.1.0" not file_has "$GH_STATE/releases/v0.1.1" "First feature"

section "versions compare numerically (0.9.0 → 0.10.0)"
new_project numeric
release_ok 0.9.0
release_ok 0.10.0
check "tag v0.10.0 on origin" tag_on_origin v0.10.0

section "bad version format"
new_project format
add_note "Something"
snapshot
for v in v1.2.3 1.2 1.2.3.4 1.2.x ""; do
  run just release "$v"
  check "'$v' fails" not status_is 0
  check "'$v' says the format" output_has 'Version must look like 1.2.3 (no "v" prefix).'
done
unchanged

section "version not greater than the last release"
new_project increasing
release_ok 0.2.0
add_note "More"
snapshot
run just release 0.1.9
check "lower fails" status_is 1
check "lower names last release" output_has "0.1.9 must be greater than the last release (0.2.0)."
run just release 0.2.0
check "same fails" status_is 1
check "same names the tag" output_has "Tag v0.2.0 already exists locally"
unchanged

section "empty Unreleased fails before bump"
new_project empty
snapshot
run just release 0.1.0
check "exits 1" status_is 1
check "says what to do" output_has 'add a line describing this release, then rerun.'
check "didn't test or bump" not output_has "==> Testing"
unchanged

section "dirty tree"
new_project dirty
add_note "Something"
echo changed > version.txt
run just release 0.1.0
check "modified file fails" status_is 1
check "modified file says what to do" output_has "Working tree not clean — commit or stash first. git status"
check "modified file left alone" file_is version.txt changed
git checkout -- .
echo new > untracked.txt
run just release 0.1.0
check "untracked file fails" status_is 1
check "untracked file says what to do" output_has "Working tree not clean"
check "no tag" not tag_local v0.1.0

section "not on main"
new_project branch
add_note "Something"
git switch --quiet -c feature
run just release 0.1.0
check "exits 1" status_is 1
check "says what to do" output_has "Releases run from main (you're on feature) — git switch main"

section "out of sync with origin"
new_project sync
add_note "Something"
git clone --quiet "$O" "$ROOT/cases/sync/other"
(cd "$ROOT/cases/sync/other" && echo x > other.txt && git add other.txt && git commit --quiet -m other && git push --quiet origin main 2> /dev/null)
snapshot
run just release 0.1.0
check "behind fails" status_is 1
check "behind says what to do" output_has "Not in sync with origin/main — git pull (or push your commits first)."
unchanged
git pull --quiet --ff-only origin main 2> /dev/null
echo y > local.txt && git add local.txt && git commit --quiet -m local
run just release 0.1.0
check "ahead fails" status_is 1
check "ahead says what to do" output_has "Not in sync with origin/main"

section "tag already exists"
new_project tags
add_note "Something"
git tag -a v0.1.0 -m v0.1.0
run just release 0.1.0
check "local tag fails" status_is 1
check "local tag says what to do" output_has "Tag v0.1.0 already exists locally — pick a new version, or git tag -d v0.1.0 if it's stale."
git tag -d v0.1.0 > /dev/null
git clone --quiet "$O" "$ROOT/cases/tags/other"
(cd "$ROOT/cases/tags/other" && git tag -a v0.1.0 -m v0.1.0 && git push --quiet origin v0.1.0 2> /dev/null)
snapshot
run just release 0.1.0
check "origin tag fails" status_is 1
check "origin tag says what to do" output_has "Tag v0.1.0 already exists on origin — pick a new version."
unchanged

section "gh not authenticated"
new_project auth
add_note "Something"
echo fail > "$GH_STATE/auth"
snapshot
run just release 0.1.0
check "exits 1" status_is 1
check "says what to do" output_has "gh is not authenticated — gh auth login"
unchanged

section "tests fail"
new_project tests-fail false
add_note "Something"
snapshot
run just release 0.1.0
check "exits 1" status_is 1
check "says what to do" output_has "Tests failed. Fix them, then rerun: just release 0.1.0"
unchanged

section "bump fails partway"
new_project bump-fail true "echo VERSION > version.txt && false"
add_note "Something"
run just release 0.1.0
check "exits 1" status_is 1
check "says how to undo" output_has "Undo with: git checkout -- ."
check "nothing committed" not tag_local v0.1.0
git checkout -- .
check "undo restores a clean tree" tree_clean

section "publish fails"
new_project publish-fail true "echo VERSION > version.txt" false
add_note "Something"
snapshot
run just release 0.1.0
check "exits 1" status_is 1
check "names unrelease" output_has "Publish failed — nothing has left your machine. Undo with: just unrelease 0.1.0"
check "nothing pushed" origin_main_is "$snap_origin"
check "tag not on origin" not tag_on_origin v0.1.0
check "no GitHub release" not gh_release v0.1.0
run just unrelease 0.1.0
check "unrelease exits 0" status_is 0
unchanged

section "push fails after publish, then release-finish"
new_project push-fail
add_note "Something"
printf '#!/bin/sh\necho "rejected by test hook" >&2\nexit 1\n' > "$O/hooks/pre-receive"
chmod +x "$O/hooks/pre-receive"
run just release 0.1.0
check "exits 1" status_is 1
check "names release-finish" output_has "Published 0.1.0 but didn't finish. Fix the problem above, then run: just release-finish 0.1.0"
check "tag not on origin" not tag_on_origin v0.1.0
check "no GitHub release" not gh_release v0.1.0
rm "$O/hooks/pre-receive"
run just release-finish 0.1.0
check "release-finish exits 0" status_is 0
check "tag on origin" tag_on_origin v0.1.0
check "main pushed" origin_main_is "$(git rev-parse HEAD)"
check "GitHub release created" gh_release v0.1.0

section "release-finish is idempotent"
new_project finish-twice
release_ok 0.1.0
run just release-finish 0.1.0
check "second run exits 0" status_is 0
check "second run skips the release" output_has "GitHub release v0.1.0 already exists"
check "release created once" [ "$(gh_calls 'release create')" -eq 1 ]
run just release-finish 0.2.0
check "unknown tag fails" status_is 1
check "unknown tag says so" output_has "No local tag v0.2.0 — nothing to finish."

section "unrelease refuses a public tag"
new_project unrelease-public
release_ok 0.1.0
head=$(git rev-parse HEAD)
run just unrelease 0.1.0
check "exits 1" status_is 1
check "says release forward" output_has "v0.1.0 is already on origin — it's public. Release forward with a new version instead."
check "tag kept" tag_local v0.1.0
check "HEAD kept" head_is "$head"

section "branch protection"
new_project protection
add_note "Something"
echo 1 > "$GH_STATE/api_rules"
snapshot
run just release 0.1.0
check "pull_request rule fails" status_is 1
check "pull_request rule says why" output_has "main requires pull requests — this starter can't push there. Protected repos should release through CI."
unchanged
echo error > "$GH_STATE/api_rules"
echo error > "$GH_STATE/api_protected"
run just release 0.1.0
check "API error still releases" status_is 0
check "API error warns" output_has "warning: Couldn't check main's rulesets on GitHub — continuing."
add_note "More"
echo 0 > "$GH_STATE/api_rules"
echo true > "$GH_STATE/api_protected"
run just release 0.1.1
check "classic protection still releases" status_is 0
check "classic protection warns" output_has "main has classic branch protection"

section "gh not installed"
new_project no-gh
add_note "Something"
mkdir -p "$ROOT/nogh"
ln -sf "$(command -v just)" "$ROOT/nogh/just"
ln -sf "$(command -v git)" "$ROOT/nogh/git"
if PATH="/usr/bin:/bin" command -v gh > /dev/null; then
  echo "    (skipped: gh is installed in /usr/bin or /bin)"
else
  run env PATH="$ROOT/nogh:/usr/bin:/bin" just release 0.1.0
  check "exits 1" status_is 1
  check "says how to install" output_has "gh not found — install it: https://cli.github.com"
fi

section "just --dry-run release 1.2.3"
cd "$STARTER"
run just --dry-run release 1.2.3
check "exits 0" status_is 0
check "expands the version" output_has "version='1.2.3'"
check "expands bump-cmd" output_has "npm version 1.2.3 --no-git-tag-version"

echo
echo "$passed passed, $failed failed"
[ "$failed" -eq 0 ]
